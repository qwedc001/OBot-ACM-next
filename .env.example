# FastAPI receives QQ callbacks; HTTPX calls the official QQ API.
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

COMMAND_START=["/"]
COMMAND_SEP=["."]

# Replace [] with the example below and fill in AppID / AppSecret.
# QQ_BOTS=[{"id":"YOUR_APP_ID","secret":"YOUR_APP_SECRET","use_websocket":false}]
QQ_BOTS=[]
QQ_VERIFY_WEBHOOK=true

# Shared framework configuration. Values below are optional defaults.
OBOT_DATA_DIR=data
OBOT_PLATFORMS=["qq"]
# configured keeps QQ_BOTS.use_websocket; websocket/webhook explicitly override it.
OBOT_QQ_TRANSPORT=configured
OBOT_JOB_WORKERS=2
OBOT_JOB_CAPACITY=32
OBOT_JOB_TIMEOUT=60
OBOT_HTTP_TIMEOUT=15
OBOT_HTTP_CONCURRENCY=4
OBOT_SUPERUSERS=[]
OBOT_ARTIFACT_TTL=3600
# HTTPS root origin for dashboard login and one-use board binding.
OBOT_PUBLIC_BASE_URL=
OBOT_BOARD_BIND_TTL=900
OBOT_BOARD_TIMEZONE=Asia/Shanghai
# Optional internal machine API: set a long random token, never expose it in the browser.
# OBOT_INTERNAL_TOKEN=CHANGE_ME

# Web login lifetime / browser session lifetime in seconds.
OBOT_WEB_LOGIN_TTL=300
OBOT_WEB_SESSION_TTL=43200
# Default frontend output: frontend/dist (run pnpm --dir frontend build).
# OBOT_FRONTEND_DIST=frontend/dist

# Observed QQ group administrator authority lifetime for the web dashboard.
OBOT_WEB_GROUP_TTL=900
