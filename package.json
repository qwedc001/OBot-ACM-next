{
  "name": "obot-acm-next-monorepo",
  "version": "0.17.0",
  "private": true,
  "description": "OBot-ACM Next Monorepo",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dump:openapi": "uv run python scripts/dump_openapi.py",
    "codegen": "pnpm --filter @obot/contracts codegen",
    "build:contracts": "pnpm --filter @obot/contracts build",
    "gen:contracts": "pnpm run dump:openapi && pnpm run codegen && pnpm run build:contracts",
    "build": "pnpm --filter @obot/contracts build && pnpm --filter @obot/web build",
    "test": "pnpm --filter @obot/web test"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
